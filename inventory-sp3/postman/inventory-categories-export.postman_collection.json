            "pm.test('Devuelve un producto', () => pm.expect(pm.response.json().product.products).to.be.an('array').that.is.not.empty);"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/products/{{productId}}"
      },
      "response": []
    },
    {
